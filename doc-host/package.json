{
  "name": "everythingapp-host",
  "productName": "EverythingApp",
  "version": "0.1.0",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "start": "node tools/start.js",
    "probe": "node tools/start.js --probe fixtures/escape-probe.ev.html",
    "assemble": "node tools/assemble.js",
    "smoke": "node tools/start.js --smoke",
    "package": "electron-builder",
    "packaged-probe": "node tools/packaged-probe.js",
    "build-module": "node modules/build.js"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@electron/fuses": "^2.1.3",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "0.28.2",
    "jsdom": "^30.1.2"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "description": "EverythingApp: a desktop host for self-contained HTML documents",
  "author": "telemersion"
}
